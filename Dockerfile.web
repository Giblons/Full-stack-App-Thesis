# Production image for a frontend (customer or GCS), served as static files on
# 0.0.0.0. Vite inlines env at BUILD time, so VITE_API_URL must be passed as a
# build arg pointing at the *public* API URL the browser will reach.
#
#   docker build -f Dockerfile.web \
#     --build-arg APP=customer \
#     --build-arg VITE_API_URL=https://api.example.com \
#     -t drone-customer .
ARG APP=customer

FROM node:22-alpine AS build
ARG APP
ARG VITE_API_URL=""
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY services/api/package.json services/api/
COPY apps/customer/package.json apps/customer/
COPY apps/gcs/package.json apps/gcs/
RUN npm ci
COPY . .
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build:shared && npm run build --workspace @drone/${APP}

FROM node:22-alpine
ARG APP
WORKDIR /app
RUN npm install -g serve@14
COPY --from=build /app/apps/${APP}/dist ./dist
EXPOSE 8080
# -s = single-page-app fallback to index.html.
CMD ["serve", "-s", "dist", "-l", "tcp://0.0.0.0:8080"]
